# ===== Python =====
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# ===== Virtual environments =====
venv/
.venv/
env/

# ===== Notebook/ =====
.ipynb_checkpoints/
Notebook/.ipynb_checkpoints/

# ===== Secrets =====
.env
.streamlit/secrets.toml

# ===== OS / editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== data/ =====
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# ===== models/ =====
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
