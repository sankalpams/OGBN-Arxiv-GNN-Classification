# =========================
*.log
*.tmp
*.temp
*.bak

# =========================
# Data
# =========================
data/raw/*
data/processed/*

# Keep data folders in Git
!data/raw/.gitkeep
!data/processed/.gitkeep

# =========================
# Generated Results
# =========================
results/*
!results/.gitkeep

