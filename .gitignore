# =========================
__pycache__/
*.py[cod]
*.pyo
*.so
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/

